{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": null,
  "outputDirectory": "docs",
  "framework": null,
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [
        {"key": "Cache-Control", "value": "public, max-age=60, stale-while-revalidate=300"}
      ]
    }
  ]
}
